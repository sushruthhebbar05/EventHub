# Copy this file to ".env" and edit the values. NEVER commit the real .env file.

# PostgreSQL connection (user:password@host:port/database)
DATABASE_URL=postgresql+psycopg2://eventhub:CHANGE_ME@localhost:5432/eventhub

# Generate your own secret:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_to_a_long_random_string_of_at_least_32_characters
ACCESS_TOKEN_MINUTES=60

# Seat holds
HOLD_SECONDS=300
EXPIRY_SWEEP_SECONDS=5
MAX_SEATS_PER_BOOKING=6

# true = organiser events stay PENDING until an admin approves them
REQUIRE_EVENT_APPROVAL=true

CORS_ORIGINS=http://localhost:5173
